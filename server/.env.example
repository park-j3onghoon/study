# Claude Max(OAuth)로 동작하므로 API 키는 불필요하다.
# main.py가 시작 시 ANTHROPIC_API_KEY를 pop하여 무력화하고 `claude login` OAuth를 강제한다.
# (아래에 키를 채워도 무시됨 — Max 구독 사용을 위한 의도적 비활성화)
ANTHROPIC_API_KEY=

# Default model used when chat request doesn't specify one.
# Overridable per request via the `model` field.
DEFAULT_MODEL=claude-opus-4-7

# Default extended-thinking budget (tokens).
# 0 = thinking disabled. Recommended: 16000 (ultrathink), 4000 (low), 0 (off).
DEFAULT_THINKING_BUDGET=0
